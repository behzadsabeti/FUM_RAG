# Qdrant Configuration
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here

# OpenRouter Configuration (for Qwen LLM)
OPENROUTER_API_KEY=your_openrouter_api_key_here
QWEN_MODEL=qwen/qwen-2.5-72b-instruct:free

# Optional: Site information for OpenRouter rankings
# These are used in the HTTP headers when making API calls
SITE_URL=https://github.com/FUM_RAG
SITE_NAME=FUM RAG System
